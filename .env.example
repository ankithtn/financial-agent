# Never put a real API key in this file.
GROQ_API_KEY=your_groq_api_key_here

LLM_ENABLED=1
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_VISION_MODEL=qwen/qwen3.6-27b

# Free Groq tier: conservative pacing to reduce rate-limit failures.
LLM_MIN_INTERVAL_SECONDS=2.05

# Set these to the prices applicable to your Groq account/plan.
# Keep 0 for a free-key run.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0
